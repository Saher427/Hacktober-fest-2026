# GitHub Personal Access Token (required for private repos and higher rate limits)
# Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# Ollama base URL (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Default model (qwen2.5-coder:7b or qwen2.5-coder:3b for lower RAM)
OLLAMA_MODEL=qwen2.5-coder:7b

# Embedding model
OLLAMA_EMBED_MODEL=nomic-embed-text

# Local storage path for cloned repos and chromadb
REPOS_CACHE_DIR=./repos_cache
CHROMA_PERSIST_DIR=./chroma_db
